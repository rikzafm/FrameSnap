{
  "name": "frame-snap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension for downloading video, making GIFs and snapping frames",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "icons": "tsx scripts/build-icons.ts",
    "build": "npm run icons && vite build",
    "build:personal": "npm run icons && vite build --mode personal --outDir dist-personal",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
