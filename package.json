{
  "name": "frame-snap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extension (Chrome and Firefox) for downloading video, making GIFs and snapping frames",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "dev:firefox": "vite --mode firefox",
    "icons": "tsx scripts/build-icons.ts",
    "build": "npm run icons && vite build",
    "build:firefox": "npm run icons && vite build --mode firefox",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:engine": "vitest run tests/engine --testTimeout 150000",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "zip": "npm run build && tsx scripts/zip.ts dist",
    "zip:firefox": "npm run build:firefox && tsx scripts/zip.ts dist-firefox",
    "store:assets": "tsx scripts/store-assets.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@vitest/browser": "^3.2.7",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2"
  }
}
